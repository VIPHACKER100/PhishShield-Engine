# PhishShield-Engine Environment Configuration
# Copy this file to .env and fill in production values.
# DO NOT commit .env to version control — it is listed in .gitignore.
#
# For local development without a real secrets vault, you may also create
# config/secrets.json using config/secrets.example.json as a template.
# That file is also listed in .gitignore and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=phish
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=phish_db
DATABASE_URL=postgresql://phish:CHANGE_ME_IN_PRODUCTION@postgres:5432/phish_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis

# ---------------------------------------------------------------------------
# Auth — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# Generate a strong JWT secret (run once, then store the output here):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# JWT token lifetime in hours (default: 1). Shorter is more secure.
JWT_EXPIRY_HOURS=1

# Account lockout: max consecutive failed logins before temporary lock
LOGIN_MAX_ATTEMPTS=5

# How long (minutes) a locked account stays locked
LOGIN_LOCKOUT_MINUTES=15

# How long (hours) a password-reset token remains valid
RESET_TOKEN_EXPIRY_HOURS=1

# ---------------------------------------------------------------------------
# Kafka Stream Consumer (optional — only needed if using live email streaming)
# ---------------------------------------------------------------------------

# Kafka bootstrap server address (host:port)
KAFKA_BROKER_URL=CHANGE_ME_IN_PRODUCTION

# Kafka topic to consume emails from
KAFKA_TOPIC=email_ingest

# ---------------------------------------------------------------------------
# Email / SMTP Transport (optional — only needed for password reset emails)
# ---------------------------------------------------------------------------

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------

# Sentry DSN for error tracking (leave blank to disable)
# SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME

# ---------------------------------------------------------------------------
# Deployment & Security
# ---------------------------------------------------------------------------

# Set to "prod" in production. The app will refuse to start if JWT_SECRET
# is missing or is the placeholder value when ENV=prod.
ENV=prod

# Set ENFORCE_HTTPS=true to automatically redirect HTTP traffic to HTTPS
ENFORCE_HTTPS=false
ENABLE_HTTPS_REDIRECT=false
