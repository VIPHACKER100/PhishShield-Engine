# PhishShield-Engine Environment Configuration
# Copy this file to .env and fill in production values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=phish
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=phish_db
DATABASE_URL=postgresql://phish:CHANGE_ME_IN_PRODUCTION@postgres:5432/phish_db

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=redis

# ---------------------------------------------------------------------------
# Auth — REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# Generate a strong JWT secret (run once, then store the output here):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION

# JWT token lifetime in hours (default: 1). Shorter is more secure.
JWT_EXPIRY_HOURS=1

# Account lockout: max consecutive failed logins before temporary lock
LOGIN_MAX_ATTEMPTS=5

# How long (minutes) a locked account stays locked
LOGIN_LOCKOUT_MINUTES=15

# How long (hours) a password-reset token remains valid
RESET_TOKEN_EXPIRY_HOURS=1

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

# Set to "prod" in production. The app will refuse to start if JWT_SECRET
# is missing or is the placeholder value when ENV=prod.
ENV=prod
